# 백엔드 API의 절대 URL. 필수 - 기본값이 없고, 없으면 시작에 실패한다.
#
# 세 백엔드 템플릿의 공개 계약이 통일되어 있으므로 이 값 하나만 바꾸면
# FastAPI · NestJS · Rails 사이를 오갈 수 있다. 어댑터 계층이 없다.
#
#   FastAPI  http://localhost:4000
#   NestJS   http://localhost:4000
#   Rails    http://localhost:4000
#
# docker-compose.e2e.yml 안에서는 서비스 이름을 쓴다 - http://api:4000
BACKEND_URL=http://localhost:4000

# 세션 쿠키에 Secure 속성을 붙일지. 선택 - 기본값은 NODE_ENV === "production" 이다.
# lib/config/settings.ts 의 기본값과 같은 값을 여기에 적는다.
# SESSION_COOKIE_SECURE=false
